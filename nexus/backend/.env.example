# BRIDGE 2026 — nexus backend environment
# Copy to `.env` and fill in real values. Never commit the filled-in .env.

# Runtime
NODE_ENV=development
PORT=3001

# CORS: the frontend origin allowed to call this API (credentialed)
FRONTEND_URL=http://localhost:3000

# Global rate limit (requests per minute per IP)
RATE_LIMIT_GLOBAL=120

# Database (PostgreSQL) — either a single URL…
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bridge2026
# …or the individual fields (used only when DATABASE_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bridge2026

# Blockchain
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MOSS_COIN_ADDRESS=0x8bbfe65e31b348cd823c62e02ad8c19a84dd0dab

# LLM provider (Google Gemini)
GEMINI_API_KEY=
