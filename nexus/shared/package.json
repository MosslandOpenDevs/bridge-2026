{
  "name": "@bridge-2026/shared",
  "version": "0.1.0",
  "description": "Shared types and utilities for BRIDGE 2026",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "watch": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "governance",
    "bridge-2026",
    "shared",
    "types",
    "utilities"
  ],
  "author": "",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "uuid": "^9.0.0"
  },
  "dependencies": {
    "@types/uuid": "^9.0.0"
  }
}
