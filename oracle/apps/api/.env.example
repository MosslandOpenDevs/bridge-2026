# ============================================
# LLM Configuration (for AI Agent Deliberation)
# ============================================

# Anthropic API Key (https://console.anthropic.com/)
# Supports: Claude 3.5 Sonnet, Claude 3 Opus, etc.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (https://platform.openai.com/api-keys)
# Supports: GPT-4o, GPT-4 Turbo, etc.
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: "anthropic" or "openai" (auto-detected from API key if not set)
# LLM_PROVIDER=anthropic

# LLM Model (optional, defaults based on provider)
# Anthropic: claude-sonnet-4-20250514
# OpenAI: gpt-4o
# LLM_MODEL=claude-sonnet-4-20250514

# ============================================
# External Data Sources
# ============================================

# Etherscan API Key (https://etherscan.io/apis)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Twitter Bearer Token (https://developer.twitter.com/)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# GitHub Personal Access Token (https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# Mossland API URL (optional, defaults to https://disclosure.moss.land)
MOSSLAND_API_URL=https://disclosure.moss.land

# Synthetic demo signals — three random values a minute, so a fresh clone has
# something to show before any real data source is configured.
# Default: on outside production, OFF when NODE_ENV=production.
#
# Turning this on in production means invented numbers reach issue detection.
# They are marked synthetic wherever they surface, and issues detected from
# them are skipped by automatic deliberation and automatic proposals, so they
# cost nothing in LLM calls — but they do appear in the issues feed next to
# real ones. Deliberating one by hand still works.
# ENABLE_MOCK_SIGNALS=0

# ============================================
# Server Configuration
# ============================================

# Server Port
PORT=4000

# Signal language: "en" or "ko"
SIGNAL_LANGUAGE=en

# Auto signal collection interval in seconds (0 to disable, default: 60)
SIGNAL_COLLECT_INTERVAL=60

# Auto issue detection interval in seconds (0 to disable, default: 300)
ISSUE_DETECT_INTERVAL=300

# ============================================
# Blockchain (MOC verification)
# ============================================

# Ethereum mainnet RPC for read-only MOC balance checks (vote eligibility +
# voting weight). Defaults to a public RPC (https://ethereum-rpc.publicnode.com)
# so MOC verification is ON out of the box. Set a dedicated Alchemy/Infura URL
# for production reliability, or "off" to disable and run in demo mode.
# MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# On-chain proposal/vote recording (OracleGovernance contract). All three must
# be set to enable; see docs/BLOCKCHAIN_SETUP.md.
# RPC_URL=
# ORACLE_PRIVATE_KEY=
# GOVERNANCE_CONTRACT_ADDRESS=
# CHAIN_ID=1

# ============================================
# Security
# ============================================

# Admin API key. REQUIRED when NODE_ENV=production — the process refuses to
# start without it, because these endpoints have no other authentication:
# signals/collect, issues/detect, issues/:id, deliberate, debate, proposals
# (create), proposals/:id/finalize, proposals/:id/execute, outcomes and
# outcome measurements.
#
# Without a key the admin endpoints answer 503 rather than running anonymously.
# Minimum 16 characters. Send it as:
#   x-admin-api-key: <value>     OR     Authorization: Bearer <value>
ADMIN_API_KEY=

# Local demos only, ignored when NODE_ENV=production: leaves every admin
# endpoint anonymous. Never set this on a host anyone else can reach.
# DEMO_MODE=1

# Vote signature enforcement: "auto" | "always" | "never" (default: auto).
# - auto:   require signature only when MOC verification is enabled
# - always: always require an EIP-191 signed message from the voter
# - never:  trust the voter address as-is (demo mode only — INSECURE for prod)
REQUIRE_VOTE_SIGNATURE=auto

# Delegation signature enforcement: "always" (default) | "never".
# A delegation hands an agent the delegator's voting influence, so creating or
# revoking one requires a signature from that wallet. "never" is honoured only
# outside production.
REQUIRE_DELEGATION_SIGNATURE=always

# Where voting power comes from: "snapshot" (default) | "current".
# - snapshot: balance at the block the proposal pinned when it was created, so
#             moving tokens between wallets mid-vote cannot mint extra power.
#             Needs an archive-capable MAINNET_RPC_URL.
# - current:  live balance. NOT sybil-resistant across wallets; use only when
#             the RPC cannot serve historical state.
VOTE_WEIGHT_MODE=snapshot

# Maximum number of debate sessions to keep in memory (LRU eviction).
DEBATE_SESSION_LIMIT=100

# ============================================
# Governance timing
# ============================================
# Production defaults are real windows; all are overridable so tests can run
# the full lifecycle quickly.

# Shortest voting period a proposal may request, in ms.
# Default: 3600000 (1 hour) in production, 1000 outside it.
# MIN_VOTING_PERIOD_MS=3600000

# Voting period used when a proposal does not specify one, in ms (default: 7 days).
# DEFAULT_VOTING_PERIOD_MS=604800000

# Timelock between a proposal passing and becoming executable, in ms.
# Mirrors the contract's executionDelay.
# Default: 172800000 (2 days) in production, 0 outside it.
# EXECUTION_DELAY_MS=172800000

# Observation window after execution before KPIs may be measured, in ms
# (default: 86400000, 24 hours). A proof cannot be issued before this elapses.
# KPI_MEASUREMENT_DELAY_MS=86400000

# How often to close out proposals whose voting period ended, in seconds
# (0 disables; default 60).
# AUTO_FINALIZE_INTERVAL=60

# Window in which a repeat detection counts as a duplicate issue, in minutes
# (default: 15).
# ISSUE_DEDUPE_MINUTES=15

# ============================================
# Runtime
# ============================================

# Production hardening: suppresses raw error messages, and makes ADMIN_API_KEY
# mandatory and the governance timing defaults real.
NODE_ENV=development
