# ============================================
# LLM Configuration (for AI Agent Deliberation)
# ============================================

# Setting either key switches the governance agents from their rule-based
# fallback to real LLM calls. On its own that only affects deliberations and
# debates you request (POST /api/deliberate, POST /api/debate); see
# "Autonomous loop" below for the jobs that would spend unattended, all of
# which are off unless you turn them on.

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: "anthropic" | "openai" | "ollama".
# Auto-detected from the key prefix when unset — and ANTHROPIC_API_KEY WINS if
# both keys are present, which is easy to miss when debugging a bill.
# LLM_PROVIDER=anthropic

# LLM Model (optional, defaults per provider: claude-sonnet-4-20250514 for
# anthropic, gpt-5.4-mini for openai). The model that actually answered is
# reported by GET /api/llm/usage — it can differ from what was requested.
# LLM_MODEL=claude-sonnet-4-20250514

# ============================================
# External Data Sources
# ============================================

# Etherscan API Key (https://etherscan.io/apis)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Twitter Bearer Token (https://developer.twitter.com/)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# GitHub Personal Access Token (https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# Mossland API URL (optional, defaults to https://disclosure.moss.land)
MOSSLAND_API_URL=https://disclosure.moss.land

# GitHub API base and the RSS-to-JSON service the Medium feed is read through
# (optional; the e2e suite points them at a closed port to stay offline)
# GITHUB_API_URL=https://api.github.com
# RSS_TO_JSON_URL=https://api.rss2json.com/v1/api.json

# Synthetic demo signals — three random values a minute, so a fresh clone has
# something to show before any real data source is configured.
# Default: OFF everywhere. Set this to 1 to run the demo, including locally.
#
# Turning this on in production means invented numbers reach issue detection.
# They are marked synthetic wherever they surface, and issues detected from
# them are skipped by automatic deliberation and automatic proposals, so they
# cost nothing in LLM calls — but they do appear in the issues feed next to
# real ones. Deliberating one by hand still works.
#
# They are also counted apart from real data in GET /api/stats: the headline
# totals there are observations, and these land under `synthetic`.
# ENABLE_MOCK_SIGNALS=0

# ============================================
# Server Configuration
# ============================================

# Server Port
PORT=4000

# Address to listen on (default: unset = every interface). Set it to the one
# address your reverse proxy connects to, e.g. the app VM's tailnet IP
# 100.109.139.25, so nothing else on the LAN can reach the API around nginx.
# Anything that probes the port locally must then use that address too
# (curl http://100.109.139.25:3101/..., not localhost:3101) — in particular
# deploy.sh's health gate, which calls DEPLOY_API_URL (default
# http://127.0.0.1:3101). Otherwise every API deploy fails its gate, and the
# rollback's health check fails the same way.
# DEPLOY_API_URL is NOT read from this file: deploy.sh only sees the
# environment of the bridge-deploy pm2 process, so it has to be set there, e.g.
#   DEPLOY_API_URL=http://100.109.139.25:3101 pm2 restart bridge-deploy --update-env && pm2 save
# and re-exported whenever that process is re-registered (a later
# `pm2 restart ecosystem.config.cjs --update-env` from a shell without it can
# drop it).
# HOST=100.109.139.25

# Who may set X-Forwarded-For, which the per-IP rate limits key on
# (default: 1 = trust whoever connects directly, i.e. one proxy hop).
# Either a hop count, or a comma-separated list of proxy IPs/CIDRs — the list
# is the safer choice when the port is reachable without the proxy, since a
# direct caller then counts as its own address whatever header it sends.
# An invalid value stops the process at startup.
# TRUST_PROXY=100.107.17.114

# Signal language: "en" or "ko"
SIGNAL_LANGUAGE=en

# Auto signal collection interval in seconds (0 to disable, default: 60)
SIGNAL_COLLECT_INTERVAL=60

# GET /api/health reports "degraded" when no observed signal has landed for
# this many seconds (default: max(180, 3 x SIGNAL_COLLECT_INTERVAL)). Ignored
# when collection is off — with nothing scheduled there is no freshness to miss.
# HEALTH_STALE_AFTER_SECONDS=180

# Auto issue detection interval in seconds (0 to disable, default: 300)
ISSUE_DETECT_INTERVAL=300

# How many minutes of signals each detection pass reads (default: 120, at
# least 1). Levels such as the MOC price or the week's blog post count are
# sampled once per SIGNAL_COLLECT_INTERVAL across the window from their stored
# changes, up to the last observation and not past it; events such as a price
# alert or a new disclosure are read as stored. With collection off every row
# in the window is read as stored. The detectors used to read the newest 1,000
# rows, which spanned ~124 minutes until 2026-08-08 and 125-166 after.
# The window must hold at least 5 collection intervals (the trend fit needs 5
# readings of a level); when it does not — e.g. 120 with SIGNAL_COLLECT_INTERVAL
# of 1800 or more — the API widens it to 5 intervals and logs a warning.
# DETECTION_WINDOW_MINUTES=120

# ============================================
# Autonomous loop — OFF BY DEFAULT, AND IT SPENDS MONEY WHEN ON
# ============================================
# All three are OFF by default; set one to 1 to opt in. Turned on with an LLM
# key configured, the server decides and proposes on its own, with no human in
# the loop. Without a key everything below falls back to a rule-based path and
# costs nothing. Signal collection and issue detection above run either way.
#
# They were on by default until September 2026. In production the loop opened
# proposals mostly from a collector artifact, promoted some that most agents
# opposed, and none was ever voted on.
#
# Booleans accept 1/0, true/false, yes/no, on/off. An unrecognised value stops
# the process at startup rather than being guessed at.

# Deliberate automatically on newly detected issues (default: off).
# Each deliberation is FIVE LLM calls — four agents plus a moderator synthesis —
# and runs unattended every ISSUE_DETECT_INTERVAL seconds. This is the single
# largest source of API spend in the system when enabled.
# AUTO_DELIBERATE_ENABLED=1

# Lowest issue priority worth deliberating: low | medium | high | urgent
# (default: high). Lowering this multiplies the call volume.
# AUTO_DELIBERATE_MIN_PRIORITY=high

# Ceiling on deliberations per detection pass (default: 10, so at most 50 LLM
# calls per pass). A backstop against a detector emitting a flood, not a budget.
# Issues dropped by this cap are NOT retried — their rows already exist, so the
# next pass no longer sees them as new. It logs loudly when it bites.
# AUTO_DELIBERATE_MAX_PER_CYCLE=10

# Promote a deliberation to a governance proposal automatically when consensus
# clears the threshold (default: off, 0.7). Acts only on automatic
# deliberations, so it does nothing unless AUTO_DELIBERATE_ENABLED is on too.
# An auto-promoted proposal is pinned to a chain snapshot and immediately open
# for voting, so this turns LLM output into live governance without review.
# Note that consensusScore measures how much the agents agree, not whether they
# agree to act: a unanimous "oppose" clears the threshold as well.
# AUTO_PROPOSAL_ENABLED=1
# AUTO_PROPOSAL_THRESHOLD=0.7
# AUTO_PROPOSAL_PROPOSER=auto-system

# Periodically score past decisions against what followed (default: off, every
# 1800s when on). Database-only — no LLM calls. The score is a proxy (follow-up
# issue counts), stored as "estimated", and the learning queries ignore
# estimated outcomes — so this only fills decision_history for inspection.
# OUTCOME_EVAL_ENABLED=1
# OUTCOME_EVAL_INTERVAL=1800

# Token accounting for GET /api/llm/usage (admin). Tokens are always counted;
# these only add a USD estimate, and are left unset on purpose so a stale price
# cannot produce a confident wrong number. Check your provider's current
# pricing before setting them.
# LLM_PRICE_INPUT_PER_MTOK=0.75
# LLM_PRICE_OUTPUT_PER_MTOK=4.50

# ============================================
# Blockchain (MOC verification)
# ============================================

# Ethereum mainnet RPC for read-only MOC balance checks (vote eligibility +
# voting weight). Defaults to a public RPC (https://ethereum-rpc.publicnode.com)
# so MOC verification is ON out of the box. Set a dedicated Alchemy/Infura URL
# for production reliability, or "off" to disable and run in demo mode.
# MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# On-chain proposal/vote recording (OracleGovernance contract). All three must
# be set to enable; see docs/BLOCKCHAIN_SETUP.md.
# RPC_URL=
# ORACLE_PRIVATE_KEY=
# GOVERNANCE_CONTRACT_ADDRESS=
# CHAIN_ID=1

# ============================================
# Security
# ============================================

# Admin API key. REQUIRED when NODE_ENV=production — the process refuses to
# start without it, because these endpoints have no other authentication:
# signals/collect, issues/detect, issues/:id, deliberate, debate, proposals
# (create), proposals/:id/finalize, proposals/:id/execute, outcomes and
# outcome measurements.
#
# Without a key the admin endpoints answer 503 rather than running anonymously.
# Minimum 16 characters. Send it as:
#   x-admin-api-key: <value>     OR     Authorization: Bearer <value>
ADMIN_API_KEY=

# Local demos only, ignored when NODE_ENV=production: leaves every admin
# endpoint anonymous. Never set this on a host anyone else can reach.
# DEMO_MODE=1

# Vote signature enforcement: "auto" | "always" | "never" (default: auto).
# - auto:   require signature only when MOC verification is enabled
# - always: always require an EIP-191 signed message from the voter
# - never:  trust the voter address as-is (demo mode only — INSECURE for prod)
REQUIRE_VOTE_SIGNATURE=auto

# Delegation signature enforcement: "always" (default) | "never".
# A delegation hands an agent the delegator's voting influence, so creating or
# revoking one requires a signature from that wallet. "never" is honoured only
# outside production.
REQUIRE_DELEGATION_SIGNATURE=always

# Where voting power comes from: "snapshot" (default) | "current".
# - snapshot: balance at the block the proposal pinned when it was created, so
#             moving tokens between wallets mid-vote cannot mint extra power.
#             Needs an archive-capable MAINNET_RPC_URL.
# - current:  live balance. NOT sybil-resistant across wallets; use only when
#             the RPC cannot serve historical state.
VOTE_WEIGHT_MODE=snapshot

# Maximum number of debate sessions to keep in memory (LRU eviction).
DEBATE_SESSION_LIMIT=100

# ============================================
# Scheduled database backups (scripts/db-backup.cjs)
# ============================================
# Read by the backup script, not by the API. It runs only once an operator
# registers the pm2 app `bridge-db-backup` — see oracle/deploy/README.md
# "Scheduled backups & restore". Nothing here does anything until then.
#
# Each run writes data/backup/daily-YYYYMMDD-HHMMSS.db[.gz] (UTC) plus a
# .sha256 sidecar, deletes the copy if PRAGMA quick_check is not "ok", and
# records the result in data/backup/.last-backup.json. Rotation only ever
# touches daily-* files: pre-deploy-*.db and manual-*.db are never removed.

# Where backups go (default: a "backup" directory next to DB_PATH).
# BACKUP_DIR=data/backup

# gzip each backup (default: on). Measured on the production copy: 418MB ->
# 124MB, about 7-13s of CPU per run. On by default because the database shares
# a disk with its backups (ten files: ~1.3GB gzipped, ~4.2GB plain). 0 keeps
# plain .db files.
# BACKUP_GZIP=0

# Retention: the newest backup of each of the N most recent days that have one,
# plus the newest of each of the M most recent ISO weeks that have one
# (defaults 7 and 4 — 10 files), plus every backup from the 24h before the
# newest, so extra runs on one day never push older days out.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4

# Refuse to start a backup that would leave less than this much disk free, in
# MB (default 1024). SQLite on a full disk fails the API's writes, not ours.
# BACKUP_MIN_FREE_MB=1024

# Off-host copy (default: none). An rsync destination; each new backup and its
# .sha256 are sent there after the local copy is verified. A failed transfer
# keeps the local backup and makes the run exit non-zero. The remote side is
# not rotated by this script — give it its own retention.
# rsync runs without a shell: write the SSH command with absolute paths (no ~).
# BACKUP_RSYNC_TARGET=backup@backup-host:/srv/backups/bridge/
# BACKUP_RSYNC_SSH=ssh -i /home/<user>/.ssh/bridge_backup -o BatchMode=yes
# BACKUP_RSYNC_TIMEOUT_SECONDS=900

# ============================================
# Governance timing
# ============================================
# Production defaults are real windows; all are overridable so tests can run
# the full lifecycle quickly.

# BRIDGE's own voting and delegation (default: off). Mossland DAO votes on
# Agora (https://agora.moss.land); BRIDGE proposals are non-binding. Off, the
# vote and delegation writes (POST /api/proposals/:id/vote, POST and DELETE
# /api/delegations) answer 410 with code VOTING_MOVED_TO_AGORA; reads, admin
# proposal creation and auto-finalize work as before. The web app has its own
# build-time switch, NEXT_PUBLIC_VOTING_ENABLED — turn both on together.
#
# Turning it on in production is a manual step: deploy.sh rebuilds and
# restarts only when tracked files change, so editing env files and pushing
# nothing does not redeploy. On the app server:
#   1. API: set VOTING_ENABLED=1 in oracle/apps/api/.env (read by dotenv at
#      boot), then `pm2 restart oracle-api`.
#   2. Web: add NEXT_PUBLIC_VOTING_ENABLED=1 to oracle/apps/web/.env.production
#      (Next reads it at build time), rebuild the web the way deploy.sh does
#      (NEXT_DIST_DIR=.next.new pnpm --filter "@oracle/web..." build, then swap
#      .next.new in for .next), then `pm2 restart oracle-web`.
# VOTING_ENABLED=1

# Shortest voting period a proposal may request, in ms.
# Default: 3600000 (1 hour) in production, 1000 outside it.
# MIN_VOTING_PERIOD_MS=3600000

# Voting period used when a proposal does not specify one, in ms (default: 7 days).
# DEFAULT_VOTING_PERIOD_MS=604800000

# Timelock between a proposal passing and becoming executable, in ms.
# Mirrors the contract's executionDelay.
# Default: 172800000 (2 days) in production, 0 outside it.
# EXECUTION_DELAY_MS=172800000

# Observation window after execution before KPIs may be measured, in ms
# (default: 86400000, 24 hours). A proof cannot be issued before this elapses.
# KPI_MEASUREMENT_DELAY_MS=86400000

# How often to close out proposals whose voting period ended, in seconds
# (0 disables; default 60).
# AUTO_FINALIZE_INTERVAL=60

# (ISSUE_DEDUPE_MINUTES was removed. Repeat detections are now matched against
# the open issue for the same condition with no time window at all, so a
# situation that persists stays one issue and is deliberated once. The old
# window made this a frequency cap: a steady condition became a brand-new issue
# — and a new five-call deliberation — every 15 minutes, indefinitely.)

# ============================================
# Runtime
# ============================================

# Production hardening: suppresses raw error messages, and makes ADMIN_API_KEY
# mandatory and the governance timing defaults real.
NODE_ENV=development
