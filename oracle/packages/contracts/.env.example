# ============================================
# Network RPC endpoints
# ============================================

# Sepolia RPC (Alchemy / Infura — NOT a public node, it will rate-limit)
# Create a new app at https://dashboard.alchemy.com/ and paste the full URL.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key

# Mainnet (only if you're *ready* to deploy to mainnet; otherwise leave blank)
# MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# ============================================
# Deployment keys
# ============================================

# DEPLOY KEY — used only to deploy & configure roles, then (recommended) renounces
# operational roles. This should be a FRESH EOA, not your personal mainnet wallet.
# Sepolia faucet: https://sepoliafaucet.com/
PRIVATE_KEY=

# ============================================
# Role assignments (recommended for safer ops)
# ============================================

# Oracle EOA — the address the backend API will use to sign castVote/recordOutcome.
# MUST be different from PRIVATE_KEY above; its private key goes into
# apps/api/.env:ORACLE_PRIVATE_KEY.
ORACLE_ADDRESS=

# Executor EOA — address allowed to call executeProposal() after the timelock.
# If blank, defaults to the deploy key. Recommended: a multisig (Safe) on mainnet.
EXECUTOR_ADDRESS=

# Pauser EOA — can freeze the contract in emergencies. Recommended: a multisig.
PAUSER_ADDRESS=

# Proposer EOA — can create proposals. If your backend is the only proposer,
# this can equal ORACLE_ADDRESS.
PROPOSER_ADDRESS=

# If "true", the deploy script will renounce the deployer's operational roles
# (ORACLE/EXECUTOR/PAUSER/PROPOSER) after granting them to the addresses above.
# DEFAULT_ADMIN_ROLE is kept so the deployer can still rotate roles later.
# Strongly recommended for Sepolia and mandatory for mainnet.
RENOUNCE_DEPLOYER_ROLES=false

# ============================================
# Etherscan verification (optional but recommended)
# ============================================
# https://etherscan.io/myapikey — a single key works for mainnet + Sepolia.
ETHERSCAN_API_KEY=
